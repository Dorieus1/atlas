PORT=5050

# A long random string used to sign login sessions. Any random text works.
JWT_SECRET=

OPENAI_API_KEY=

# Used to send password-reset emails. Get a key at resend.com.
RESEND_API_KEY=

# The web address customers land on when they click a password-reset email.
FRONTEND_URL=http://localhost:5173

# Lets businesses accept online invoice payments (Stripe Connect). Get a
# free account and a test-mode secret key at dashboard.stripe.com - it
# starts with sk_test_. Not required for anything else in the app to work.
STRIPE_SECRET_KEY=

# From Stripe's Connect webhook settings (Developers > Webhooks > Connect),
# once you've pointed a webhook endpoint at /api/stripe/webhook and told it
# to listen for the checkout.session.completed event on connected accounts.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Optional: only needed if you want the database file somewhere other than the default.
# DB_PATH=./atlas.db
